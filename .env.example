# Copy to .env and fill in. Never commit .env.
# Gmail access in this runtime is provided by the connected Gmail connector;
# these variables cover direct-OAuth deployments and output targets.

# Direct Gmail OAuth (only needed when NOT using the connector transport)
# GMAIL_CLIENT_SECRETS_FILE=/path/to/client_secrets.json
# GMAIL_TOKEN_FILE=data/token.json

# Google Sheets output (connector transport needs no key)
# GOOG_SHEETS_SPREADSHEET_ID=

# AI providers (optional; core framework works without any LLM)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
